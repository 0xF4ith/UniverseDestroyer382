# ===================== Universe Destroyer 382 =====================
# Copy this file to .env and fill it in. Never share .env or commit it.

# Demo mode: simulated fills, no real SOL is spent. Leave true until the demo results convince you.
DRY_RUN=true

# Offline demo: invents a market so you can try everything without any network (DRY_RUN only).
SIM_FEED=false
SIM_SPEED=1

# ---------- keys (only needed for live mode) ----------
# Wallet private key: base58 string or the [1,2,3,...] JSON array from a Solana keypair file.
# Use a FRESH wallet holding only what you're willing to lose.
PRIVATE_KEY=
# Your own RPC (Helius / QuickNode / Triton). The public endpoint blocks the holder checks.
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
# Optional, recommended: PumpPortal API key (needs a linked wallet with >= 0.02 SOL; metered).
# Without it, prices come from reading the bonding curve on your RPC every CURVE_POLL_MS.
PUMPPORTAL_API_KEY=
# Optional: Jupiter API key (higher price-API limits). Blank uses lite-api.jup.ag.
JUP_API_KEY=
# Also push each swap through your RPC next to the Jito bundle (helps it land).
ALSO_SEND_VIA_RPC=true

# ---------- bankroll + sizing ----------
POSITION_SOL=0.03
MAX_OPEN_POSITIONS=10
MIN_START_BALANCE_SOL=1.0
RESERVE_SOL=0.05
DEMO_BANKROLL_SOL=1.0

# ---------- entry + safety filters ----------
ENTRY_MCAP_MIN_USD=6800
ENTRY_MCAP_MAX_USD=7500
MIN_HOLDERS=15
TOP10_MAX_PCT=25
CREATOR_MAX_PCT=5

# ---------- fees + execution ----------
PRIORITY_FEE_SOL=0.0005
JITO_TIP_SOL=0.0005
SLIPPAGE_PCT=18
PUMPPORTAL_POOL=auto

# ---------- exits (no price stop loss) ----------
TP1_MCAP_USD=21000
TP1_SELL_PCT=45
TP2_MCAP_USD=50000
TP2_SELL_PCT=25
TP3_MCAP_USD=100000
TP3_SELL_PCT=20
TP4_MCAP_USD=150000
TP4_SELL_PCT=10
KILL_AFTER_MIN=20
KILL_MIN_VOL_5M_SOL=1.5
DUST_SOL=0.003

# ---------- rent reclaim ----------
RECLAIM_BATCH=8
RECLAIM_EVERY_SEC=60

# ---------- watchlist + data ----------
WATCH_MAX_AGE_MIN=15
WATCH_MAX=150
CURVE_POLL_MS=2500
SOL_USD_FALLBACK=150

# ---------- demo fill model ----------
SIM_SLIPPAGE_PCT=3
PUMP_FEE_PCT=1.25

DB_PATH=data/db.json
